# Database. Prefer DATABASE_URL in production; DB_* remains supported.
DATABASE_URL=postgres://db_user:db_password@db_host:5432/db_name
DATABASE_SSL_REQUIRE=False
DB_NAME=panorama_db
DB_USER=panorama_user
DB_PASSWORD=replace-with-database-password
DB_HOST=db
DB_PORT=5432

# Redis, JWT, notifications
REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TIMEOUT=300
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14
FCM_SERVER_KEY=replace-with-fcm-server-key-or-leave-empty-if-unused
CELERY_TASK_TIME_LIMIT=300
CELERY_LOG_LEVEL=INFO
OTP_CLEANUP_RETENTION_DAYS=1
OTP_CLEANUP_INTERVAL_SECONDS=86400
MAX_OTP_VERIFY_ATTEMPTS=5
MAX_CHAT_MESSAGE_LENGTH=4000
MAX_IMAGE_UPLOAD_SIZE_MB=5
MAX_DOCUMENT_UPLOAD_SIZE_MB=25
PROTECTED_MEDIA_TOKEN_TTL_SECONDS=300
GROUP_CHAT_WS_TOKEN_TTL_SECONDS=120
ALLOW_WEBSOCKET_ACCESS_TOKEN_AUTH=False
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENT_EXTENSIONS=pdf,doc,docx,ppt,pptx,xls,xlsx,txt,jpg,jpeg,png
THROTTLE_LOGIN=5/minute
THROTTLE_REGISTER=5/hour
THROTTLE_OTP_SEND=3/10min
THROTTLE_OTP_VERIFY=5/10min
THROTTLE_PASSWORD_RESET=3/15min
THROTTLE_VERIFICATION_SUBMIT=3/hour
THROTTLE_CHANGE_PASSWORD=5/minute
THROTTLE_CHAT_MESSAGE=30/minute
THROTTLE_SUPPORT_TICKET_CREATE=5/hour
THROTTLE_SUPPORT_MESSAGE=20/minute
THROTTLE_PRINT_ORDER_CREATE=10/hour

# Container startup controls
RUN_DEPLOY_CHECK=True
RUN_MIGRATIONS=True
RUN_COLLECTSTATIC=True
RUN_SETUP_ADMIN_ACCOUNTS=True
RUN_SEED_DATA=False
WAIT_FOR_DATABASE=True
WAIT_FOR_REDIS=True
