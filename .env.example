DJANGO_SETTINGS_MODULE=config.settings.production
IMAGE_TAG=replace-with-immutable-git-sha
RELEASE_VERSION=replace-with-release-version
BUILD_DATE=2026-01-01T00:00:00Z
SECRET_KEY=replace-with-64-plus-random-characters
DEBUG=False
API_DOCS_ENABLED=False

ALLOWED_HOSTS=api.panorama.example
CORS_ALLOWED_ORIGINS=https://dashboard.panorama.example
CSRF_TRUSTED_ORIGINS=https://api.panorama.example,https://dashboard.panorama.example
APP_BASE_URL=https://api.panorama.example

DATABASE_URL=postgresql://user:strong-password@db:5432/panorama
DATABASE_SSL_REQUIRE=True
REDIS_URL=redis://:strong-redis-password@redis:6379/0

PORT=8000
HEALTHCHECK_HOST=api.panorama.example
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_HOST=True
LOG_LEVEL=INFO
TRUSTED_PROXY_COUNT=1

# Official Panorama sender. Generate a Gmail App Password; never use the normal Gmail password.
SUPPORT_EMAIL=panoramacompany31@gmail.com
DEFAULT_FROM_EMAIL=panoramacompany31@gmail.com
SERVER_EMAIL=panoramacompany31@gmail.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=panoramacompany31@gmail.com
EMAIL_HOST_PASSWORD=replace-with-gmail-app-password
EMAIL_TIMEOUT=15
OTP_DEFAULT_CHANNEL=email
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
RETURN_DEVELOPMENT_OTP=False
SMS_OTP_PROVIDER_ENABLED=False

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14
THROTTLE_AUTH_LOGIN=8/min
THROTTLE_AUTH_REGISTER=4/hour
THROTTLE_OTP_REQUEST=3/10min
THROTTLE_OTP_VERIFY=8/10min
THROTTLE_PASSWORD_RESET=4/hour
THROTTLE_FEEDBACK=20/day
THROTTLE_FILE_TICKET=60/hour
THROTTLE_EXTERNAL_CHANNEL=20/hour

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-fernet-key
FILE_ACCESS_TICKET_TTL_SECONDS=120
FILE_ACCESS_TICKET_MAX_USES=8
EXTERNAL_CHANNEL_TICKET_TTL_SECONDS=60
VERIFICATION_CARD_RETENTION_DAYS=90
MAX_DOCUMENT_UPLOAD_SIZE=26214400
MAX_IMAGE_UPLOAD_SIZE=8388608
LECTURE_MAX_UPLOAD_SIZE=52428800
LECTURE_MAX_PAGES=500
LECTURE_VIEWER_SESSION_TTL_SECONDS=900
LECTURE_VIEWER_SESSION_MAX_PAGE_REQUESTS=1200
THROTTLE_LECTURE_VIEWER=240/min
THROTTLE_LECTURE_NOTES=90/min
DOCUMENT_CONVERSION_TIME_LIMIT=180
DOCUMENT_CONVERSION_SOFT_TIME_LIMIT=150
# Keep disabled unless the conversion-worker image is provisioned with ClamAV.
DOCUMENT_ANTIVIRUS_ENABLED=False

# Current storage configuration. Set these as runtime variables in Coolify,
# not as build variables. Mount the named volume at MEDIA_ROOT.
STORAGE_BACKEND=local
MEDIA_ROOT=/app/app/media
MEDIA_URL=/media/

# Future optional generic S3-compatible storage (not enabled in this release).
# STORAGE_BACKEND=s3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_ENDPOINT_URL=
# S3_REGION=
# S3_SIGNATURE_VERSION=s3v4

FCM_SERVER_KEY=
SENTRY_DSN=

# Release job only
RUN_SETUP_ADMIN_ACCOUNTS=False
RUN_SEED_DATA=False
RUN_SEED_PRODUCTION_DEFAULTS=False
DJANGO_SUPERUSER_EMAIL=it-admin@example.com
DJANGO_SUPERUSER_PHONE=+0000000000
DJANGO_SUPERUSER_PASSWORD=replace-me
DJANGO_SUPERUSER_FULL_NAME=Panorama IT Support
RESET_ADMIN_PASSWORDS=False

THROTTLE_CHAT_MESSAGE=30/min
THROTTLE_CHAT_REPORT=10/day

# Push notifications (Expo)
PUSH_NOTIFICATIONS_ENABLED=False
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=

# Data retention
OTP_RETENTION_DAYS=7
ACCESS_TICKET_RETENTION_HOURS=24
FEEDBACK_PROMPT_EVENT_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=730

THROTTLE_SUPPORT_TICKET=5/hour
THROTTLE_SUPPORT_MESSAGE=30/hour

# Background jobs
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_TIME_LIMIT=60
CELERY_TASK_SOFT_TIME_LIMIT=45
CELERY_CONVERSION_CONCURRENCY=1
