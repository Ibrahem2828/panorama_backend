# Django settings
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-generated-django-secret-key
DEBUG=False
DJANGO_DEBUG=False
PORT=8000
LOG_LEVEL=INFO

# Host and browser security. Use explicit deployed domains; do not use "*".
ALLOWED_HOSTS=api.example.com
DJANGO_ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://dashboard.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com,https://dashboard.example.com
CORS_ALLOWED_ORIGINS=https://dashboard.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://dashboard.example.com
SECURE_SSL_REDIRECT=True
DJANGO_SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
DJANGO_SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
X_FRAME_OPTIONS=DENY
USE_X_FORWARDED_HOST=True
DJANGO_USE_X_FORWARDED_HOST=True

# Database. Prefer DATABASE_URL in production; DB_* remains supported.
DATABASE_URL=postgres://db_user:db_password@db_host:5432/db_name
DATABASE_SSL_REQUIRE=False
DB_NAME=panorama_db
DB_USER=panorama_user
DB_PASSWORD=replace-with-database-password
DB_HOST=db
DB_PORT=5432

# Redis, JWT, notifications
REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TIMEOUT=300
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14
FCM_SERVER_KEY=replace-with-fcm-server-key-or-leave-empty-if-unused
MAX_OTP_VERIFY_ATTEMPTS=5
MAX_CHAT_MESSAGE_LENGTH=4000
MAX_IMAGE_UPLOAD_SIZE_MB=5
MAX_DOCUMENT_UPLOAD_SIZE_MB=25
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENT_EXTENSIONS=pdf,doc,docx,ppt,pptx,xls,xlsx,txt,jpg,jpeg,png
THROTTLE_AUTH_LOGIN=10/minute
THROTTLE_OTP_SEND=5/minute
THROTTLE_OTP_VERIFY=10/minute
THROTTLE_PASSWORD_RESET=5/minute
THROTTLE_CHANGE_PASSWORD=5/minute
THROTTLE_CHAT_MESSAGE=30/minute
THROTTLE_SUPPORT_MESSAGE=20/minute
THROTTLE_PRINT_ORDER=10/minute

# Container startup controls
RUN_MIGRATIONS=True
RUN_COLLECTSTATIC=True
RUN_SETUP_ADMIN_ACCOUNTS=True
RUN_SEED_DATA=False

# Bootstrap dashboard accounts. Replace all passwords before production use.
DJANGO_SUPERUSER_EMAIL=it@panorama.local
DJANGO_SUPERUSER_PHONE=+963900000001
DJANGO_SUPERUSER_PASSWORD=replace-with-strong-it-support-password
DJANGO_SUPERUSER_FULL_NAME=Panorama IT Support
DASHBOARD_ADMIN_EMAIL=admin@panorama.local
DASHBOARD_ADMIN_PHONE=+963900000002
DASHBOARD_ADMIN_PASSWORD=replace-with-strong-admin-password
DASHBOARD_ADMIN_FULL_NAME=Panorama Admin
PRINT_STAFF_EMAIL=print@panorama.local
PRINT_STAFF_PHONE=+963900000003
PRINT_STAFF_PASSWORD=replace-with-strong-print-staff-password
PRINT_STAFF_FULL_NAME=Panorama Print Staff
RESET_ADMIN_PASSWORDS=False
