{
  "name": "Panorama Mobile API",
  "version": "1.0.0",
  "base_url": "{{base_url}}",
  "auth": {
    "type": "bearer",
    "token_variable": "{{access_token}}"
  },
  "groups": [
    {
      "name": "Auth",
      "endpoints": [
        {"name": "Register Normal User", "method": "POST", "path": "/api/v1/auth/register/normal/", "auth_required": false, "access": "public", "request_body": {"full_name": "Ahmad Ali", "email": "ahmad@example.com", "phone_number": "+963900000000", "password": "StrongPass123!", "password_confirm": "StrongPass123!"}, "success_response_example": {"success": true, "message": "تم إنشاء الحساب بنجاح. أرسلنا رمز تحقق إلى رقم الجوال لتفعيل الحساب.", "data": {"user": {"id": 1, "role": "normal_user", "phone_verified": false, "requires_phone_verification": true}, "requires_otp": true, "otp_purpose": "verify_phone", "phone_number": "+963900000000", "phone_verified": false, "requires_phone_verification": true, "next_step": "verify_phone", "expires_in_seconds": 600, "resend_after_seconds": 60}}, "error_response_example": {"success": false, "message": "Validation error", "errors": {}}, "notes": ["Immediately sends verify_phone OTP. Returns development_otp only when enabled in backend settings."]},
        {"name": "Verify Phone", "method": "POST", "path": "/api/v1/auth/verify-phone/", "auth_required": false, "access": "public", "request_body": {"phone_number": "+963900000000", "code": "123456"}, "success_response_example": {"success": true, "message": "تم التحقق من رقم الجوال بنجاح. يمكنك تسجيل الدخول الآن.", "data": {"phone_verified": true, "requires_phone_verification": false, "is_phone_verified": true, "next_step": "login"}}, "error_response_example": {"success": false, "errors": {"code": ["Invalid OTP code."]}}, "notes": ["Alias for verify_phone OTP. purpose defaults to verify_phone."]},
        {"name": "Submit Student Account Request", "method": "POST", "path": "/api/v1/auth/student-account-requests/", "auth_required": false, "access": "public", "request_body": {"full_name": "Student", "email": "student@example.com", "phone_number": "+963900000001", "university": 1, "faculty": 1, "major": 1, "student_number": "41234567", "password": "StrongPass123!", "password_confirm": "StrongPass123!", "uploaded_card": "<file>"}, "success_response_example": {"success": true, "message": "تم إرسال طلب إنشاء حساب الطالب بنجاح. سيتم مراجعة بياناتك من قبل الإدارة.", "data": {"request_id": "uuid", "status": "pending_review", "next_step": "admin_review"}}, "error_response_example": {"success": false, "errors": {}}, "notes": ["multipart/form-data. No OTP generated at submission."]},
        {"name": "Student Account Request Status", "method": "GET", "path": "/api/v1/auth/student-account-requests/00000000-0000-0000-0000-000000000001/status/?phone_number=+963900000001", "auth_required": false, "access": "public", "request_body": null, "success_response_example": {"success": true, "data": {"request_id": "00000000-0000-0000-0000-000000000001", "status": "otp_sent", "can_enter_otp": true, "can_resubmit": false}}, "error_response_example": {"success": false, "errors": {}}, "notes": ["Replace example UUID with real request_id. Never returns OTP."]},
        {"name": "Verify Student Account OTP", "method": "POST", "path": "/api/v1/auth/student-account-requests/00000000-0000-0000-0000-000000000001/verify-otp/", "auth_required": false, "access": "public", "request_body": {"code": "123456"}, "success_response_example": {"success": true, "message": "تم تفعيل حساب الطالب بنجاح. يمكنك تسجيل الدخول الآن.", "data": {"status": "active", "next_step": "login"}}, "error_response_example": {"success": false, "errors": {"code": ["Invalid OTP code."]}}, "notes": ["Replace example UUID with real request_id. Activates student account after admin approval."]},
        {"name": "Register Student", "method": "POST", "path": "/api/v1/auth/register/student/", "auth_required": false, "access": "public", "request_body": {"full_name": "Student", "email": "student@example.com", "phone_number": "+963900000001", "password": "StrongPass123!", "password_confirm": "StrongPass123!", "student_number": "2150094"}, "success_response_example": {"success": true, "data": {"user": {"role": "student"}}}, "error_response_example": {"success": false, "errors": {"student_number": ["Invalid format"]}}, "notes": ["Student number is parsed and validated by backend."]},
        {"name": "Login", "method": "POST", "path": "/api/v1/auth/login/", "auth_required": false, "access": "public", "request_body": {"identifier": "student@example.com", "password": "StrongPass123!"}, "success_response_example": {"success": true, "data": {"access": "{{access_token}}", "refresh": "{{refresh_token}}", "user": {"id": 1}}}, "error_response_example": {"success": false, "message": "Validation error", "errors": {"identifier": ["Invalid credentials."]}}, "notes": ["identifier can be email or phone."]},
        {"name": "Refresh Token", "method": "POST", "path": "/api/v1/auth/token/refresh/", "auth_required": false, "access": "public", "request_body": {"refresh": "{{refresh_token}}"}, "success_response_example": {"success": true, "data": {"access": "{{access_token}}"}}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "Logout", "method": "POST", "path": "/api/v1/auth/logout/", "auth_required": true, "access": "authenticated", "request_body": {"refresh": "{{refresh_token}}"}, "success_response_example": {"success": true, "message": "Logged out successfully", "data": {}}, "error_response_example": {"success": false, "errors": {"refresh": "Invalid token"}}, "notes": []},
        {"name": "Current User", "method": "GET", "path": "/api/v1/auth/me/", "auth_required": true, "access": "authenticated", "request_body": null, "success_response_example": {"success": true, "data": {"email": "student@example.com"}}, "error_response_example": {"success": false, "message": "Authentication credentials were not provided", "errors": {}}, "notes": []},
        {"name": "Update Current User", "method": "PATCH", "path": "/api/v1/auth/me/", "auth_required": true, "access": "authenticated", "request_body": {"full_name": "New Name", "username": "student1"}, "success_response_example": {"success": true, "data": {"full_name": "New Name"}}, "error_response_example": {"success": false, "errors": {}}, "notes": ["role/email/phone are not user editable here."]},
        {"name": "Change Password", "method": "POST", "path": "/api/v1/auth/change-password/", "auth_required": true, "access": "authenticated", "request_body": {"old_password": "StrongPass123!", "new_password": "NewStrongPass123!", "new_password_confirm": "NewStrongPass123!"}, "success_response_example": {"success": true}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "Send OTP", "method": "POST", "path": "/api/v1/auth/otp/send/", "auth_required": false, "access": "public", "request_body": {"phone_number": "+963900000000", "purpose": "verify_phone"}, "success_response_example": {"success": true, "data": {"expires_at": "2026-01-01T00:00:00Z"}}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "Verify OTP", "method": "POST", "path": "/api/v1/auth/otp/verify/", "auth_required": false, "access": "public", "request_body": {"phone_number": "+963900000000", "purpose": "verify_phone", "code": "123456"}, "success_response_example": {"success": true}, "error_response_example": {"success": false, "errors": {"code": ["Invalid OTP code."]}}, "notes": []},
        {"name": "Request Password Reset", "method": "POST", "path": "/api/v1/auth/request-password-reset/", "auth_required": false, "access": "public", "request_body": {"phone_number": "+963900000000"}, "success_response_example": {"success": true}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "Confirm Password Reset", "method": "POST", "path": "/api/v1/auth/confirm-password-reset/", "auth_required": false, "access": "public", "request_body": {"phone_number": "+963900000000", "code": "123456", "new_password": "NewStrongPass123!", "new_password_confirm": "NewStrongPass123!"}, "success_response_example": {"success": true}, "error_response_example": {"success": false, "errors": {}}, "notes": []}
      ]
    },
    {
      "name": "Student Profile",
      "endpoints": [
        {"name": "Get My Student Profile", "method": "GET", "path": "/api/v1/students/me/profile/", "auth_required": true, "access": "student", "request_body": null, "success_response_example": {"success": true, "data": {"verification_status": "approved"}}, "error_response_example": {"success": false, "message": "Permission denied", "errors": {}}, "notes": []},
        {"name": "Update My Student Profile", "method": "PATCH", "path": "/api/v1/students/me/profile/", "auth_required": true, "access": "student before approval", "request_body": {"university": 1, "faculty": 2, "major": 3, "academic_year": 1, "semester": 1, "student_number": "2150094"}, "success_response_example": {"success": true, "data": {"student_number": "2150094"}}, "error_response_example": {"success": false, "errors": {"student_number": ["Student number does not match selected faculty."]}}, "notes": ["Approved students cannot change sensitive academic identity fields."]},
        {"name": "Parse Student Number", "method": "GET", "path": "/api/v1/students/student-number/parse/?student_number=2150094", "auth_required": true, "access": "authenticated", "request_body": null, "success_response_example": {"success": true, "data": {"faculty_code": "2", "enrollment_year_full": 2015, "serial_number": "0094"}}, "error_response_example": {"success": false, "errors": {}}, "notes": []}
      ]
    },
    {
      "name": "Academic Data",
      "endpoints": [
        {"name": "List Universities", "method": "GET", "path": "/api/v1/universities/", "auth_required": false, "access": "public", "request_body": null, "success_response_example": {"success": true, "data": {"results": []}}, "error_response_example": {"success": false, "errors": {}}, "notes": ["Supports pagination, search, ordering."]},
        {"name": "University Detail", "method": "GET", "path": "/api/v1/universities/{{university_id}}/", "auth_required": false, "access": "public", "request_body": null, "success_response_example": {"success": true, "data": {"id": 1}}, "error_response_example": {"success": false, "message": "Not found", "errors": {}}, "notes": []},
        {"name": "List Faculties For University", "method": "GET", "path": "/api/v1/universities/{{university_id}}/faculties/", "auth_required": false, "access": "public", "request_body": null, "success_response_example": {"success": true, "data": {"results": []}}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "List Majors For Faculty", "method": "GET", "path": "/api/v1/faculties/{{faculty_id}}/majors/", "auth_required": false, "access": "public", "request_body": null, "success_response_example": {"success": true, "data": {"results": []}}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "List Academic Years", "method": "GET", "path": "/api/v1/academic-years/", "auth_required": false, "access": "public", "request_body": null, "success_response_example": {"success": true, "data": {"results": []}}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "List Semesters", "method": "GET", "path": "/api/v1/semesters/", "auth_required": false, "access": "public", "request_body": null, "success_response_example": {"success": true, "data": {"results": []}}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "List Subjects For Major", "method": "GET", "path": "/api/v1/majors/{{major_id}}/subjects/", "auth_required": false, "access": "public", "request_body": null, "success_response_example": {"success": true, "data": {"results": []}}, "error_response_example": {"success": false, "errors": {}}, "notes": ["Filter by academic_year and semester."]}
      ]
    },
    {
      "name": "Verification",
      "endpoints": [
        {"name": "Submit Verification", "method": "POST", "path": "/api/v1/verification/submit/", "auth_required": true, "access": "phone-verified student", "request_body": {"university": 1, "faculty": 2, "major": 3, "academic_year": 1, "semester": 1, "student_number": "2150094", "card_image": "<file>"}, "success_response_example": {"success": true, "data": {"status": "pending"}}, "error_response_example": {"success": false, "errors": {"student_number": ["Student number does not match selected faculty."]}}, "notes": ["Use multipart/form-data for card_image."]},
        {"name": "Get My Verification", "method": "GET", "path": "/api/v1/verification/me/", "auth_required": true, "access": "student", "request_body": null, "success_response_example": {"success": true, "data": {"status": "pending"}}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "Resubmit Verification", "method": "POST", "path": "/api/v1/verification/resubmit/", "auth_required": true, "access": "student after rejected/needs_update", "request_body": {"student_number": "2150094", "card_image": "<file>"}, "success_response_example": {"success": true}, "error_response_example": {"success": false, "errors": {}}, "notes": []}
      ]
    },
    {
      "name": "Home, Groups, Chat, Files",
      "endpoints": [
        {"name": "Relevant Announcements", "method": "GET", "path": "/api/v1/announcements/", "auth_required": true, "access": "authenticated", "request_body": null, "success_response_example": {"success": true, "data": {"results": []}}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "Available Groups", "method": "GET", "path": "/api/v1/groups/available/", "auth_required": true, "access": "verified student", "request_body": null, "success_response_example": {"success": true, "data": {"results": [{"send_messages_permission": "all_members"}]}}, "error_response_example": {"success": false, "message": "Permission denied", "errors": {}}, "notes": []},
        {"name": "My Groups", "method": "GET", "path": "/api/v1/groups/my/", "auth_required": true, "access": "verified student", "request_body": null, "success_response_example": {"success": true, "data": {"results": []}}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "Group Detail", "method": "GET", "path": "/api/v1/groups/{{group_id}}/", "auth_required": true, "access": "eligible verified student", "request_body": null, "success_response_example": {"success": true, "data": {"current_user_group_role": "member", "members_count": 12}}, "error_response_example": {"success": false, "errors": {}}, "notes": ["Use send_messages_permission and current_user_group_role to render chat input, but backend remains source of truth."]},
        {"name": "Join Group", "method": "POST", "path": "/api/v1/groups/{{group_id}}/join/", "auth_required": true, "access": "verified student", "request_body": {}, "success_response_example": {"success": true, "data": {"status": "pending"}}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "Leave Group", "method": "POST", "path": "/api/v1/groups/{{group_id}}/leave/", "auth_required": true, "access": "approved group member", "request_body": {}, "success_response_example": {"success": true}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "List Files", "method": "GET", "path": "/api/v1/files/", "auth_required": true, "access": "authenticated with backend visibility filtering", "request_body": null, "success_response_example": {"success": true, "data": {"results": []}}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "File Detail", "method": "GET", "path": "/api/v1/files/{{file_id}}/", "auth_required": true, "access": "authorized by visibility", "request_body": null, "success_response_example": {"success": true, "data": {"title": "File"}}, "error_response_example": {"success": false, "message": "Permission denied", "errors": {}}, "notes": []},
        {"name": "Group Files", "method": "GET", "path": "/api/v1/groups/{{group_id}}/files/", "auth_required": true, "access": "approved group member", "request_body": null, "success_response_example": {"success": true, "data": {"results": []}}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "Group Messages", "method": "GET", "path": "/api/v1/groups/{{group_id}}/messages/", "auth_required": true, "access": "approved group member", "request_body": null, "success_response_example": {"success": true, "data": {"results": []}}, "error_response_example": {"success": false, "errors": {}}, "notes": ["Paginated."]},
        {"name": "Create Message", "method": "POST", "path": "/api/v1/groups/{{group_id}}/messages/", "auth_required": true, "access": "allowed by group send_messages_permission", "request_body": {"type": "message", "content": "Hello"}, "success_response_example": {"success": true, "data": {"content": "Hello"}}, "error_response_example": {"success": false, "message": "Permission denied", "errors": {}}, "notes": []},
        {"name": "Delete Message", "method": "DELETE", "path": "/api/v1/groups/{{group_id}}/messages/{{message_id}}/", "auth_required": true, "access": "sender or moderator/group_admin/Admin/IT", "request_body": null, "success_response_example": {"success": true}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "Report Message", "method": "POST", "path": "/api/v1/groups/{{group_id}}/messages/{{message_id}}/report/", "auth_required": true, "access": "approved group member", "request_body": {"reason": "Spam"}, "success_response_example": {"success": true}, "error_response_example": {"success": false, "errors": {}}, "notes": []}
      ],
      "websocket": {
        "url": "ws://{{host}}/ws/v1/groups/{{group_id}}/chat/?token={{access_token}}",
        "connect_requirements": ["valid JWT", "approved group membership", "not blocked", "verified student unless Admin/IT"],
        "send_text_payload": {"type": "message", "content": "Hello"},
        "typing_payload": {"type": "typing", "is_typing": true},
        "received_message_payload": {"type": "message", "data": {"id": 123, "content": "Hello", "message_type": "text"}},
        "error_payload_example": {"type": "error", "error": "You are not allowed to send messages in this group."}
      }
    },
    {
      "name": "Printing, Notifications, Support",
      "endpoints": [
        {"name": "Create Print Order", "method": "POST", "path": "/api/v1/printing/orders/", "auth_required": true, "access": "authenticated", "request_body": {"items": [{"source_file": 1, "copies": 1}], "user_notes": "Please print"}, "success_response_example": {"success": true, "data": {"status": "submitted"}}, "error_response_example": {"success": false, "errors": {}}, "notes": ["Use multipart for uploaded_file."]},
        {"name": "My Print Orders", "method": "GET", "path": "/api/v1/printing/orders/my/", "auth_required": true, "access": "own orders only", "request_body": null, "success_response_example": {"success": true, "data": {"results": []}}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "Print Order Detail", "method": "GET", "path": "/api/v1/printing/orders/{{order_id}}/", "auth_required": true, "access": "owner only", "request_body": null, "success_response_example": {"success": true, "data": {"id": 1}}, "error_response_example": {"success": false, "message": "Not found", "errors": {}}, "notes": []},
        {"name": "Cancel Print Order", "method": "POST", "path": "/api/v1/printing/orders/{{order_id}}/cancel/", "auth_required": true, "access": "owner only", "request_body": {}, "success_response_example": {"success": true}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "Notifications", "method": "GET", "path": "/api/v1/notifications/", "auth_required": true, "access": "own notifications only", "request_body": null, "success_response_example": {"success": true, "data": {"results": []}}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "Unread Count", "method": "GET", "path": "/api/v1/notifications/unread-count/", "auth_required": true, "access": "own notifications only", "request_body": null, "success_response_example": {"success": true, "data": {"count": 3}}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "Mark Notification Read", "method": "POST", "path": "/api/v1/notifications/{{notification_id}}/read/", "auth_required": true, "access": "own notification only", "request_body": {}, "success_response_example": {"success": true}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "Read All Notifications", "method": "POST", "path": "/api/v1/notifications/read-all/", "auth_required": true, "access": "own notifications only", "request_body": {}, "success_response_example": {"success": true}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "Register Device Token", "method": "POST", "path": "/api/v1/notifications/device-tokens/", "auth_required": true, "access": "authenticated", "request_body": {"token": "fcm-token", "platform": "android"}, "success_response_example": {"success": true, "data": {"id": 1}}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "Delete Device Token", "method": "DELETE", "path": "/api/v1/notifications/device-tokens/{{token_id}}/", "auth_required": true, "access": "own token only", "request_body": null, "success_response_example": {"success": true}, "error_response_example": {"success": false, "message": "Not found", "errors": {}}, "notes": []},
        {"name": "Create Support Ticket", "method": "POST", "path": "/api/v1/support/tickets/", "auth_required": true, "access": "authenticated", "request_body": {"category": "technical", "subject": "Issue", "message": "Details"}, "success_response_example": {"success": true, "data": {"id": 1}}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "My Support Tickets", "method": "GET", "path": "/api/v1/support/tickets/my/", "auth_required": true, "access": "own tickets only", "request_body": null, "success_response_example": {"success": true, "data": {"results": []}}, "error_response_example": {"success": false, "errors": {}}, "notes": []},
        {"name": "Support Ticket Detail", "method": "GET", "path": "/api/v1/support/tickets/{{ticket_id}}/", "auth_required": true, "access": "owner only", "request_body": null, "success_response_example": {"success": true, "data": {"subject": "Issue"}}, "error_response_example": {"success": false, "message": "Not found", "errors": {}}, "notes": []},
        {"name": "Add Ticket Message", "method": "POST", "path": "/api/v1/support/tickets/{{ticket_id}}/messages/", "auth_required": true, "access": "owner only", "request_body": {"message": "More details"}, "success_response_example": {"success": true}, "error_response_example": {"success": false, "errors": {}}, "notes": ["Closed/resolved tickets reject new messages."]}
      ]
    }
  ]
}
