{
  "name": "Panorama Dashboard API",
  "version": "1.0.0",
  "base_url": "{{base_url}}",
  "auth": {
    "type": "bearer",
    "token_variable": "{{access_token}}"
  },
  "groups": [
    {
      "name": "Dashboard Auth",
      "endpoints": [
        {"name": "Login", "method": "POST", "path": "/api/v1/auth/login/", "auth_required": false, "allowed_roles": ["it_support", "admin", "print_staff"], "query_params": {}, "request_body": {"identifier": "admin@panorama.local", "password": "ChangeMe123!"}, "success_response_example": {"success": true, "data": {"access": "{{access_token}}"}}, "error_response_example": {"success": false, "errors": {}}, "frontend_notes": ["Dashboard must check returned user.role before showing modules."]},
        {"name": "Refresh", "method": "POST", "path": "/api/v1/auth/token/refresh/", "auth_required": false, "allowed_roles": ["it_support", "admin", "print_staff"], "query_params": {}, "request_body": {"refresh": "{{refresh_token}}"}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Logout", "method": "POST", "path": "/api/v1/auth/logout/", "auth_required": true, "allowed_roles": ["it_support", "admin", "print_staff"], "query_params": {}, "request_body": {"refresh": "{{refresh_token}}"}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Me", "method": "GET", "path": "/api/v1/auth/me/", "auth_required": true, "allowed_roles": ["it_support", "admin", "print_staff"], "query_params": {}, "request_body": null, "success_response_example": {"success": true, "data": {"role": "admin"}}, "error_response_example": {"success": false}, "frontend_notes": []}
      ]
    },
    {
      "name": "Stats And Academic Management",
      "endpoints": [
        {"name": "Dashboard Stats", "method": "GET", "path": "/api/v1/dashboard/stats/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {}, "request_body": null, "success_response_example": {"success": true, "data": {"users": {}, "printing": {}}}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Universities CRUD", "method": "GET|POST|PATCH|DELETE", "path": "/api/v1/dashboard/universities/{{id}}/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {"search": "name/code", "is_active": true}, "request_body": {"name": "University", "code": "SPU"}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Faculties CRUD", "method": "GET|POST|PATCH|DELETE", "path": "/api/v1/dashboard/faculties/{{id}}/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {"university": 1, "search": "name/code"}, "request_body": {"university": 1, "name": "كلية طب الأسنان", "code": "2"}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": ["Use codes 1-7 for parser-compatible faculties."]},
        {"name": "Majors CRUD", "method": "GET|POST|PATCH|DELETE", "path": "/api/v1/dashboard/majors/{{id}}/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {"faculty": 1}, "request_body": {"faculty": 1, "name": "طب الأسنان", "code": "2"}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Academic Years CRUD", "method": "GET|POST|PATCH|DELETE", "path": "/api/v1/dashboard/academic-years/{{id}}/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {}, "request_body": {"name": "السنة الأولى", "order": 1}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Semesters CRUD", "method": "GET|POST|PATCH|DELETE", "path": "/api/v1/dashboard/semesters/{{id}}/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {}, "request_body": {"name": "الفصل الأول", "order": 1}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Subjects CRUD", "method": "GET|POST|PATCH|DELETE", "path": "/api/v1/dashboard/subjects/{{id}}/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {"major": 1, "academic_year": 1, "semester": 1}, "request_body": {"major": 1, "academic_year": 1, "semester": 1, "name": "تشريح 1", "code": "21"}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []}
      ]
    },
    {
      "name": "Verification, Groups, Files, Announcements",
      "endpoints": [
        {"name": "Verification Requests", "method": "GET", "path": "/api/v1/dashboard/verifications/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {"status": "pending", "search": "name/email/student_number"}, "request_body": null, "success_response_example": {"success": true, "data": {"results": []}}, "error_response_example": {"success": false}, "frontend_notes": ["Detail includes detected student-number fields."]},
        {"name": "Approve Verification", "method": "POST", "path": "/api/v1/dashboard/verifications/{{id}}/approve/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {}, "request_body": {}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Reject Verification", "method": "POST", "path": "/api/v1/dashboard/verifications/{{id}}/reject/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {}, "request_body": {"rejection_reason": "Card is unclear", "admin_note": "Internal"}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Needs Update", "method": "POST", "path": "/api/v1/dashboard/verifications/{{id}}/needs-update/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {}, "request_body": {"rejection_reason": "Upload clearer image"}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Groups CRUD", "method": "GET|POST|PATCH|DELETE", "path": "/api/v1/dashboard/groups/{{id}}/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {"university": 1, "major": 1, "search": "name"}, "request_body": {"name": "Group", "university": 1, "send_messages_permission": "all_members", "image": "<file>"}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": ["Use multipart for image upload."]},
        {"name": "Group Memberships", "method": "GET", "path": "/api/v1/dashboard/groups/{{group_id}}/memberships/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {"status": "pending"}, "request_body": null, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Join Requests", "method": "GET", "path": "/api/v1/dashboard/groups/{{group_id}}/join-requests/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {}, "request_body": null, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Approve Membership", "method": "POST", "path": "/api/v1/dashboard/group-memberships/{{id}}/approve/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {}, "request_body": {}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Reject Membership", "method": "POST", "path": "/api/v1/dashboard/group-memberships/{{id}}/reject/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {}, "request_body": {}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Block Membership", "method": "POST", "path": "/api/v1/dashboard/group-memberships/{{id}}/block/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {}, "request_body": {}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Update Membership Role", "method": "PATCH", "path": "/api/v1/dashboard/group-memberships/{{id}}/role/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {}, "request_body": {"role": "moderator"}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": ["Allowed roles: member, moderator, group_admin."]},
        {"name": "Files CRUD", "method": "GET|POST|PATCH|DELETE", "path": "/api/v1/dashboard/files/{{id}}/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {"visibility": "public", "group": 1}, "request_body": {"title": "File", "file": "<file>", "visibility": "group_only", "group": 1}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Announcements CRUD", "method": "GET|POST|PATCH|DELETE", "path": "/api/v1/dashboard/announcements/{{id}}/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {"is_active": true}, "request_body": {"title": "Announcement", "description": "Body", "target_user_type": "verified_students"}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []}
      ]
    },
    {
      "name": "Printing, Support, Audit",
      "endpoints": [
        {"name": "Print Orders", "method": "GET", "path": "/api/v1/dashboard/printing/orders/", "auth_required": true, "allowed_roles": ["it_support", "admin", "print_staff"], "query_params": {"status": "submitted", "priority": "student_priority", "search": "name/email/order id"}, "request_body": null, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": ["Print staff access is limited to printing dashboard endpoints."]},
        {"name": "Print Order Detail", "method": "GET", "path": "/api/v1/dashboard/printing/orders/{{id}}/", "auth_required": true, "allowed_roles": ["it_support", "admin", "print_staff"], "query_params": {}, "request_body": null, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Assign Print Order", "method": "PATCH", "path": "/api/v1/dashboard/printing/orders/{{id}}/assign/", "auth_required": true, "allowed_roles": ["it_support", "admin", "print_staff"], "query_params": {}, "request_body": {"assigned_to": 3}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Update Print Status", "method": "PATCH", "path": "/api/v1/dashboard/printing/orders/{{id}}/status/", "auth_required": true, "allowed_roles": ["it_support", "admin", "print_staff"], "query_params": {}, "request_body": {"status": "under_review", "note": "Checked"}, "success_response_example": {"success": true}, "error_response_example": {"success": false, "errors": {"status": ["Invalid transition"]}}, "frontend_notes": []},
        {"name": "Add Internal Print Note", "method": "POST", "path": "/api/v1/dashboard/printing/orders/{{id}}/note/", "auth_required": true, "allowed_roles": ["it_support", "admin", "print_staff"], "query_params": {}, "request_body": {"internal_notes": "Call user"}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Support Tickets", "method": "GET", "path": "/api/v1/dashboard/support/tickets/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {"status": "open", "priority": "urgent"}, "request_body": null, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Update Ticket Status", "method": "PATCH", "path": "/api/v1/dashboard/support/tickets/{{id}}/status/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {}, "request_body": {"status": "in_progress"}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Update Ticket Priority", "method": "PATCH", "path": "/api/v1/dashboard/support/tickets/{{id}}/priority/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {}, "request_body": {"priority": "high"}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Assign Ticket", "method": "POST", "path": "/api/v1/dashboard/support/tickets/{{id}}/assign/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {}, "request_body": {"assigned_to": 2}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Reply To Ticket", "method": "POST", "path": "/api/v1/dashboard/support/tickets/{{id}}/messages/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {}, "request_body": {"message": "We are checking"}, "success_response_example": {"success": true}, "error_response_example": {"success": false}, "frontend_notes": []},
        {"name": "Audit Logs", "method": "GET", "path": "/api/v1/dashboard/audit-logs/", "auth_required": true, "allowed_roles": ["it_support", "admin"], "query_params": {"action": "print_order_status_changed", "actor": 1, "target_type": "PrintOrder", "target_id": 1, "search": "email/action"}, "request_body": null, "success_response_example": {"success": true, "data": {"results": []}}, "error_response_example": {"success": false}, "frontend_notes": ["Sensitive fields are redacted server-side."]}
      ]
    }
  ]
}
